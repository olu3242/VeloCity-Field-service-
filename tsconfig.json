{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/adaptive-fabric",
    "src/autonomous-deployments",
    "src/autonomous-runtime",
    "src/cognition-graph",
    "src/digital-consciousness",
    "src/distributed-scale",
    "src/execution-economics",
    "src/execution-memory",
    "src/federation-governance",
    "src/intelligence-mesh",
    "src/memory-federation",
    "src/neural-cloud",
    "src/neural-execution",
    "src/operational-runtime",
    "src/operator-api",
    "src/orchestration-hardening",
    "src/orchestration-protocol",
    "src/plugin-sdk",
    "src/provider-infrastructure",
    "src/runtime",
    "src/runtime-brain",
    "src/runtime-cloud",
    "src/runtime-cognition",
    "src/runtime-core",
    "src/runtime-fabric",
    "src/runtime-governance",
    "src/runtime-kernel",
    "src/runtime-marketplace",
    "src/runtime-performance",
    "src/runtime-safety",
    "src/runtime-standards",
    "src/runtime-tracing",
    "src/runtime-trust",
    "src/runtime-verification",
    "src/self-healing",
    "src/simulation-cloud",
    "src/stateful-workflows",
    "src/telemetry-evolution",
    "src/workflow-evolution",
    "src/workflow-exchange",
    "src/workflow-graph"
  ]
}
