{
  "name": "velocity-field-service",
  "version": "0.1.0",
  "private": true,
  "description": "VeloCity Field Service — AI-powered local field service delivery platform",
  "author": "Zenith AI <hello@zenith-ai.co>",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "db:seed": "npx tsx supabase/seed.ts",
    "db:reset": "supabase db reset && npm run db:seed",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "agents:test": "npx tsx src/lib/agents/test-runner.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "next": "14.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
