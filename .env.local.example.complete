# VeloCity Field Service complete local environment template
# Copy to .env.local and replace placeholders with real development credentials.

# Core app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters

# Supabase
# Required for auth, database reads/writes, RLS, storage, realtime, and admin operations.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Stripe
# Required for real deposit/final payments, webhooks, refunds, Connect accounts, and payouts.
# If omitted in development, /api/payments/intent returns local-dev client secrets.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Anthropic
# Required for AI agent calls. If omitted, deterministic fallbacks are used and logged.
ANTHROPIC_API_KEY=sk-ant-replace-me

# Google
# Required for Maps UI, geocoding, routing, service area mapping, and Google OAuth provider setup.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-me
GOOGLE_OAUTH_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-me

# Twilio
# Required for outbound SMS notifications. If omitted, in-app notifications are still created.
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_PHONE_NUMBER=+15555555555

# SendGrid
# Required for outbound email notifications. If omitted, in-app notifications are still created.
SENDGRID_API_KEY=SG.replace-me
