# ──────────────────────────────────────────────────────────────────────────────
# VeloCity Field Service — Environment Variables
# Copy this file to .env.local for local development.
# All REQUIRED vars must be set before deploying to production.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe (REQUIRED) ─────────────────────────────────────────────────────────
# Register webhook at: https://dashboard.stripe.com/webhooks
# Endpoint URL: https://<your-domain>/api/webhooks/stripe
# Required events: payment_intent.succeeded, payment_intent.payment_failed,
#   charge.refunded, customer.subscription.*, invoice.payment_succeeded,
#   invoice.payment_failed, transfer.created, transfer.failed
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Anthropic (REQUIRED) ──────────────────────────────────────────────────────
# Used by AI Planning Engine (claude-haiku-4-5-20251001) and AI agents
ANTHROPIC_API_KEY=sk-ant-...

# ── App (REQUIRED) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com
# Must be >= 32 chars; generate with: openssl rand -base64 32
CRON_SECRET=your-cron-secret-at-least-32-chars

# ── Redis / Upstash (OPTIONAL — enables distributed rate limiting + locking) ──
# Create a Redis database at https://console.upstash.com
# Without these, the platform uses in-memory fallbacks (single-instance only).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Google (OPTIONAL) ─────────────────────────────────────────────────────────
# Maps: enable in Google Cloud Console → APIs & Services → Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
# OAuth: configure at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/auth/callback
GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...

# ── Twilio (OPTIONAL — SMS notifications) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ── SendGrid (OPTIONAL — email notifications) ─────────────────────────────────
# Verify sender at: https://app.sendgrid.com/settings/sender_auth
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=no-reply@your-domain.com

# ── Legacy (kept for backward compatibility — not used in new code) ────────────
NEXTAUTH_SECRET=your-secret-at-least-32-chars
