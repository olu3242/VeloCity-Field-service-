<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VeloCity Field Service — Architecture Diagram</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&family=Space+Mono&display=swap" rel="stylesheet">
  <style>
    :root {
      --black: #0a0a0f; --carbon: #111118; --graphite: #1a1a24;
      --slate: #252533; --border: #2e2e3e; --volt: #c8f135;
      --amber: #f5a623; --ice: #7ec8e3; --red: #f56565;
      --white: #f4f4f0; --muted: #8888a0;
      --font-display: 'Bebas Neue', sans-serif;
      --font-body: 'DM Sans', sans-serif;
      --font-mono: 'Space Mono', monospace;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--black); color: var(--white); font-family: var(--font-body); padding: 40px; min-height: 100vh; }
    h1 { font-family: var(--font-display); font-size: 32px; letter-spacing: 2px; margin-bottom: 8px; }
    h1 em { color: var(--volt); font-style: normal; }
    .subtitle { font-family: var(--font-mono); font-size: 11px; color: var(--muted); letter-spacing: 1px; margin-bottom: 40px; }

    .legend { display: flex; gap: 24px; margin-bottom: 32px; flex-wrap: wrap; }
    .legend-item { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); }
    .legend-dot { width: 10px; height: 10px; border-radius: 2px; }

    .arch-canvas { position: relative; width: 100%; overflow-x: auto; }

    /* Layer containers */
    .layer {
      border: 1px solid var(--border); border-radius: 8px;
      margin-bottom: 20px; overflow: visible; position: relative;
    }
    .layer-label {
      font-family: var(--font-mono); font-size: 10px; letter-spacing: 1.5px;
      padding: 8px 16px; border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 8px;
    }
    .layer-body { padding: 20px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }

    /* Nodes */
    .node {
      border-radius: 6px; padding: 12px 16px;
      font-size: 12px; font-weight: 500; position: relative;
      cursor: default; transition: transform 0.2s, box-shadow 0.2s;
      min-width: 120px; text-align: center;
    }
    .node:hover { transform: translateY(-2px); }
    .node .node-label { font-weight: 600; font-size: 13px; margin-bottom: 4px; }
    .node .node-sub { font-size: 10px; opacity: 0.7; font-family: var(--font-mono); }

    /* Color variants */
    .n-client { background: rgba(126,200,227,0.1); border: 1px solid rgba(126,200,227,0.3); color: var(--ice); }
    .n-infra  { background: rgba(200,241,53,0.08); border: 1px solid rgba(200,241,53,0.25); color: var(--volt); }
    .n-db     { background: rgba(245,166,35,0.1);  border: 1px solid rgba(245,166,35,0.3);  color: var(--amber); }
    .n-ai     { background: rgba(167,139,250,0.1); border: 1px solid rgba(167,139,250,0.3); color: #a78bfa; }
    .n-ext    { background: rgba(74,222,128,0.08); border: 1px solid rgba(74,222,128,0.25); color: #4ade80; }
    .n-admin  { background: rgba(245,101,101,0.1); border: 1px solid rgba(245,101,101,0.3); color: var(--red); }

    /* Agent grid */
    .agents-grid {
      display: grid; grid-template-columns: repeat(5, 1fr);
      gap: 8px; width: 100%;
    }
    .agent-node {
      background: rgba(167,139,250,0.08); border: 1px solid rgba(167,139,250,0.2);
      border-radius: 6px; padding: 10px; text-align: center;
      font-size: 11px; color: #c4b5fd; cursor: pointer;
      transition: all 0.2s;
    }
    .agent-node:hover { background: rgba(167,139,250,0.18); border-color: rgba(167,139,250,0.5); transform: translateY(-1px); }
    .agent-node .agent-name { font-weight: 700; font-size: 13px; margin-bottom: 2px; color: #a78bfa; }
    .agent-node .agent-role { font-family: var(--font-mono); font-size: 9px; color: var(--muted); }

    /* Arrows between layers */
    .arrow-row {
      display: flex; justify-content: center; align-items: center;
      gap: 8px; margin: -8px 0; position: relative; z-index: 10;
    }
    .arrow-label {
      font-family: var(--font-mono); font-size: 10px; color: var(--muted);
      background: var(--black); padding: 2px 8px; border: 1px solid var(--border);
      border-radius: 2px;
    }

    /* Connector SVG */
    .connectors { position: relative; height: 32px; overflow: visible; margin: 4px 0; }
    .connector-svg { width: 100%; height: 32px; }
    .connector-line { stroke: var(--border); stroke-width: 1.5; fill: none; marker-end: url(#arr); stroke-dasharray: 4 3; }

    /* Status machine */
    .status-machine { display: flex; flex-wrap: wrap; gap: 8px; padding: 20px; }
    .status-pill {
      padding: 4px 12px; border-radius: 20px; font-size: 11px;
      font-family: var(--font-mono); border: 1px solid;
    }
    .sp-pre  { background: rgba(148,163,184,0.1); border-color: rgba(148,163,184,0.3); color: #94a3b8; }
    .sp-match { background: rgba(126,200,227,0.1); border-color: rgba(126,200,227,0.3); color: var(--ice); }
    .sp-work { background: rgba(200,241,53,0.08); border-color: rgba(200,241,53,0.25); color: var(--volt); }
    .sp-pay  { background: rgba(245,166,35,0.1); border-color: rgba(245,166,35,0.3); color: var(--amber); }
    .sp-done { background: rgba(74,222,128,0.08); border-color: rgba(74,222,128,0.25); color: #4ade80; }
    .sp-err  { background: rgba(245,101,101,0.1); border-color: rgba(245,101,101,0.3); color: var(--red); }

    .section-head { font-family: var(--font-display); font-size: 20px; letter-spacing: 1px; margin: 32px 0 16px; }
    .section-head em { color: var(--volt); font-style: normal; }

    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

    /* DB Schema section */
    .db-table { background: var(--graphite); border: 1px solid var(--border); border-radius: 6px; margin-bottom: 8px; }
    .db-table-name { padding: 8px 14px; border-bottom: 1px solid var(--border); font-weight: 600; font-size: 12px; color: var(--amber); font-family: var(--font-mono); }
    .db-cols { padding: 8px 14px; font-size: 11px; color: var(--muted); font-family: var(--font-mono); display: flex; flex-wrap: wrap; gap: 4px 16px; }
    .db-pk { color: var(--volt); }
    .db-fk { color: var(--ice); }

    @media (max-width: 768px) {
      body { padding: 20px; }
      .agents-grid { grid-template-columns: repeat(2, 1fr); }
      .two-col { grid-template-columns: 1fr; }
      .layer-body { flex-direction: column; }
    }
  </style>
</head>
<body>

