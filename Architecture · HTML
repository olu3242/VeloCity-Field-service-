<!-- JOB STATUS MACHINE -->
<div class="section-head">JOB STATUS <em>MACHINE</em></div>
<div class="layer" style="border-color: rgba(200,241,53,0.15);">
  <div class="layer-label" style="color: var(--volt);">▸ 30-STATE STATUS MACHINE</div>
  <div class="status-machine">
    <!-- Pre-match -->
    <span class="status-pill sp-pre">draft</span>
    <span class="status-pill sp-pre">submitted</span>
    <span class="status-pill sp-pre">awaiting_serviceability</span>
    <span class="status-pill sp-pre">awaiting_match</span>
    <!-- Matching -->
    <span class="status-pill sp-match">offer_sent</span>
    <span class="status-pill sp-match">accepted</span>
    <span class="status-pill sp-match">scheduled</span>
    <!-- Payment / Pre-work -->
    <span class="status-pill sp-pay">deposit_required</span>
    <span class="status-pill sp-pay">deposit_paid</span>
    <!-- Active -->
    <span class="status-pill sp-work">en_route</span>
    <span class="status-pill sp-work">arrived</span>
    <span class="status-pill sp-work">diagnosis_in_progress</span>
    <span class="status-pill sp-work">quote_submitted</span>
    <span class="status-pill sp-work">awaiting_quote_approval</span>
    <span class="status-pill sp-work">quote_approved</span>
    <span class="status-pill sp-work">in_progress</span>
    <span class="status-pill sp-work">change_order_submitted</span>
    <span class="status-pill sp-work">awaiting_change_order_approval</span>
    <span class="status-pill sp-work">paused</span>
    <!-- Completion -->
    <span class="status-pill sp-done">completed_pending_confirmation</span>
    <span class="status-pill sp-done">customer_confirmed</span>
    <span class="status-pill sp-done">completed</span>
    <span class="status-pill sp-done">warranty_callback_open</span>
    <span class="status-pill sp-done">closed</span>
    <!-- Error / Dispute -->
    <span class="status-pill sp-err">disputed</span>
    <span class="status-pill sp-err">refund_pending</span>
    <span class="status-pill sp-err">cancelled_customer</span>
    <span class="status-pill sp-err">cancelled_provider</span>
    <span class="status-pill sp-err">cancelled_system</span>
    <span class="status-pill sp-err">failed_service</span>
  </div>
</div>

<!-- DB SCHEMA -->
